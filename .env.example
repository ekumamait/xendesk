# ---- Database (Neon / Supabase Postgres) ----
# Pooled connection (PgBouncer) — used by the app at runtime via the Neon adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no pooler) — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Auth (Auth.js) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
# Base URL of the deployment (http://localhost:3000 in dev).
AUTH_URL="http://localhost:3000"
